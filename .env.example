# PostgreSQL 18
POSTGRES_DB=nexus_blog
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-this-long-random-password
DATABASE_URL=postgresql://nexus:change-this-long-random-password@db:5432/nexus_blog?schema=public

# App
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret

# SMTP for six-digit email verification codes
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NEXUS <no-reply@example.com>"

# OAuth (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
